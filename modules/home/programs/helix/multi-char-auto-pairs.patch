+fn deserialize_pair_map<'de, D>(deserializer: D) -> Result<HashMap<String, String>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    let pairs = HashMap::<String, String>::deserialize(deserializer)?;
+
+    if let Some((open, close)) = pairs
+        .iter()
+        .find(|(open, close)| open.is_empty() || close.is_empty())
+    {
+        return Err(serde::de::Error::custom(format!(
+            "auto-pairs delimiters must not be empty (got {open:?} => {close:?})"
+        )));
+    }
+
+    Ok(pairs)
+}
