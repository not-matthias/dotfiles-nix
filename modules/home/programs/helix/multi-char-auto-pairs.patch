+
+/// Complete a multi-char pair when the typed char finishes a configured opener whose
+/// remaining characters already sit directly in front of the cursor:
+///
+///     ``|   + `   ->   ```|```
+///     {|    + %   ->   {%|%}
+#[must_use]
+fn hook_insert_multi(
+    doc: &Rope,
+    range: &Range,
+    ch: char,
+    pairs: &AutoPairs,
+) -> Option<(Change, Range)> {
+    let cursor = range.cursor(doc.slice(..));
+    let next_char = doc.get_char(cursor);
+
+    let pair = pairs.multis().iter().find(|pair| {
+        let open_len = pair.open.chars().count();
+
+        if open_len < 2 || !pair.open.ends_with(ch) {
+            return false;
+        }
+
+        let prefix_len = open_len - 1;
+        let prefix = &pair.open[..pair.open.len() - ch.len_utf8()];
+
+        cursor >= prefix_len
+            && slice_eq(doc, cursor - prefix_len, prefix)
+            // the closer is already there: fall through so the single-char handler
+            // can move over it instead of nesting another pair
+            && !slice_eq(doc, cursor, &pair.close)
+            // mirrors `Pair::should_close`: never pair against an adjacent word
+            && !prev_char(doc, cursor - prefix_len).is_some_and(|c| c.is_alphanumeric())
+            && !next_char.is_some_and(|c| c.is_alphanumeric())
+    })?;
+
+    let mut inserted = String::with_capacity(ch.len_utf8() + pair.close.len());
+    inserted.push(ch);
+    inserted.push_str(&pair.close);
+
+    let change = (cursor, cursor, Some(Tendril::from(inserted)));
+    let next_range = get_next_range_multi(doc, range, 1 + pair.close.chars().count());
+    let result = (change, next_range);
+
+    log::debug!("auto pair multi change: {:#?}", &result);
+
+    Some(result)
+}
+
+/// Cursor placement for a completed multi-char pair. The cursor lands directly after
+/// the typed opener char, on the first grapheme of the closer, so only one inserted
+/// char is ahead of it; `len_inserted` is the whole insertion and matters only when
+/// the selection spans several graphemes.
+fn get_next_range_multi(doc: &Rope, start_range: &Range, len_inserted: usize) -> Range {
+    if start_range.head == doc.len_chars() && start_range.anchor == doc.len_chars() {
+        return Range::new(start_range.anchor + 1, start_range.head + 1);
+    }
+
+    let doc_slice = doc.slice(..);
+    let single_grapheme = start_range.is_single_grapheme(doc_slice);
+
+    let end_head = if start_range.head == 0 || start_range.direction() == Direction::Backward {
+        start_range.head + 1
+    } else {
+        graphemes::prev_grapheme_boundary(doc_slice, start_range.head) + 2
+    };
+
+    let end_anchor = match (start_range.len(), start_range.direction()) {
+        (0, _) => end_head,
+        (1, Direction::Forward) => end_head - 1,
+        (1, Direction::Backward) => end_head + 1,
+
+        (_, Direction::Forward) => {
+            if single_grapheme {
+                graphemes::prev_grapheme_boundary(doc_slice, start_range.head) + 1
+            } else {
+                start_range.anchor
+            }
+        }
+
+        (_, Direction::Backward) => {
+            if single_grapheme {
+                graphemes::prev_grapheme_boundary(doc_slice, start_range.anchor) + len_inserted
+            } else {
+                start_range.anchor + len_inserted
+            }
+        }
+    };
+
+    Range::new(end_anchor, end_head)
+}
+
+/// Delete a whole multi-char pair when the cursor sits between its delimiters:
+/// ``` ```|``` ``` + backspace -> empty.
+#[must_use]
+fn hook_delete_multi(doc: &Rope, range: &Range, pairs: &AutoPairs) -> Option<(Deletion, Range)> {
+    let text = doc.slice(..);
+
+    // wider selections keep the single-char delete behavior
+    if !range.is_single_grapheme(text) {
+        return None;
+    }
+
+    let cursor = range.cursor(text);
+
+    let pair = pairs.multis().iter().find(|pair| {
+        let open_len = pair.open.chars().count();
+
+        cursor >= open_len
+            && slice_eq(doc, cursor - open_len, &pair.open)
+            && slice_eq(doc, cursor, &pair.close)
+    })?;
+
+    let start = cursor - pair.open.chars().count();
+    let end = cursor + pair.close.chars().count();
+    let len_after_delete = doc.len_chars() - (end - start);
+
+    let head = if start < len_after_delete {
+        start + 1
+    } else {
+        start
+    };
+
+    let next_range = if range.direction() == Direction::Backward {
+        Range::new(head, start)
+    } else {
+        Range::new(start, head)
+    };
+
+    Some(((start, end), next_range))
+}
