-(define (microscope config)
+(define (microscope config . callbacks)
+  (define on-move (if (pair? callbacks) (car callbacks) #f))
+  (define on-cancel (if (and (pair? callbacks) (pair? (cdr callbacks))) (cadr callbacks) #f))
   (define input (Input (box "") (box #f)))
-  (define state (Microscope config (box input) (box (list)) (box 0) (box 1) (box #f)))
+  (define state (Microscope config (box input) (box (list)) (box 0) (box 1) (box #f) on-move on-cancel))
 
   (Microscope-refresh state)
