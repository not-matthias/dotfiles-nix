                                (lambda () (preview (Microscope-selected-item mcs)))))
 
 
+(define (Microscope-preview-selection mcs)
+  (let ([callback (Microscope-on-move mcs)]
+        [items (unbox (Microscope-items mcs))])
+    (when (and callback (pair? items))
+      (callback (Microscope-selected-item mcs) (unbox (Microscope-state mcs))))))
+
+
+(define (Microscope-cancel mcs)
+  (let ([callback (Microscope-on-cancel mcs)])
+    (when callback
+      (callback (unbox (Microscope-state mcs))))))
+
+
 (define (Microscope-select mcs)
   (let* ([selected (Microscope-selected-item mcs)]
          [callback (Picker-on-select (Microscope-picker mcs))]
