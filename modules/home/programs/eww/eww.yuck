(deflisten niri_state
  :initial "{\"workspaces\":[],\"windows\":[],\"language\":\"\"}"
  "@NIRI_STATE_COMMAND@")

(defpoll flashgen_word :interval "3600s" :initial '{"text":"","tooltip":""}' "@FLASHGEN_COMMAND@")
(defpoll ai_claude :interval "600s" :initial '{"text":"","tooltip":"","percentage":0,"class":""}' "eww-claude-usage")
(defpoll ai_codex :interval "600s" :initial '{"text":"","tooltip":"","percentage":0,"class":""}' "eww-codex-usage")
(defpoll ai_antigravity :interval "600s" :initial '{"text":"","tooltip":"","percentage":0,"class":""}' "eww-antigravity-usage")
(defpoll dnd_status :interval "2s" :initial '{"text":"󰂚","tooltip":"Do not disturb: OFF","class":"inactive"}' "eww-dnd-status")
(defpoll idle_inhibit_status :interval "2s" :initial '{"text":"󰾪","tooltip":"Idle inhibit: OFF","class":"inactive"}' "eww-idle-inhibit-status")
(defpoll volume_status :interval "2s" :initial '{"text":"vol unavailable","tooltip":"Audio sink unavailable","class":"unavailable","percentage":0}' "eww-volume-status")
(defpoll battery_status :interval "60s" :initial '{"text":"","tooltip":"No battery","class":"unavailable","percentage":0}' "eww-battery-status")
(defwidget workspace_buttons []
  (box :class "workspaces" :space-evenly false
    (for workspace in {niri_state.workspaces}
      (button
        :class {"workspace "
          + (workspace.is_active ? "active " : "")
          + (workspace.is_focused ? "focused " : "")
          + (workspace.is_urgent ? "urgent" : "")}
        :onclick {"niri msg action focus-workspace " + workspace.idx}
        :tooltip {workspace.name ?: "Workspace " + workspace.idx}
        {workspace.name ?: workspace.idx}))))

(defwidget window_dots []
  (box :class "window-dots" :space-evenly false
    (for window in {niri_state.windows}
      (label
        :class {window.is_focused ? "window-dot focused" : "window-dot"}
        :text {window.is_focused ? "󰪥" : "󰄰"}))))

(defwidget topbar [screen]
  (centerbox :class "bar"
    (box :class "section left" :halign "start" :space-evenly false
      (workspace_buttons)
      (window_dots))
    (box :class "section center" :halign "center" :space-evenly false
      (eventbox
        :class "clock-item"
        :tooltip "Open calendar"
        :onclick "@CALENDAR_TOGGLE@ ${screen}"
        (label :class "clock" :text {formattime(EWW_TIME, "%a %d %b · %H:%M")})))
    (box :class "right" :halign "end" :space-evenly false
      (box :class "right-group" :space-evenly false
        (eventbox
          :class "right-item flashgen"
          :visible {flashgen_word.text != ""}
          :tooltip {flashgen_word.tooltip}
          :onclick "${EWW_CMD} poll flashgen_word"
          :onrightclick "@FLASHGEN_OPEN_COMMAND@"
          (label :text {flashgen_word.text})))
      (box :class "right-group merged" :space-evenly false
        (eventbox
          :class {"right-item ai-item " + ai_claude.class}
          :tooltip {ai_claude.tooltip}
          :onclick "${EWW_CMD} poll ai_claude"
          :onrightclick "eww-claude-usage --restart && ${EWW_CMD} poll ai_claude"
          (label :text {ai_claude.text}))
        (eventbox
          :class {"right-item ai-item " + ai_codex.class}
          :tooltip {ai_codex.tooltip}
          :onclick "${EWW_CMD} poll ai_codex"
          :onrightclick "eww-codex-usage --restart && ${EWW_CMD} poll ai_codex"
          (label :text {ai_codex.text}))
        (eventbox
          :class {"right-item ai-item " + ai_antigravity.class}
          :tooltip {ai_antigravity.tooltip}
          :onclick "${EWW_CMD} poll ai_antigravity"
          :onrightclick "eww-antigravity-usage --restart && ${EWW_CMD} poll ai_antigravity"
          (label :text {ai_antigravity.text})))
      (box :class "right-group merged" :space-evenly false
        (eventbox
          :class {"right-item status " + idle_inhibit_status.class}
          :tooltip {idle_inhibit_status.tooltip}
          :onclick "systemctl --user is-active --quiet eww-idle-inhibit.service && systemctl --user stop eww-idle-inhibit.service || systemctl --user start eww-idle-inhibit.service; ${EWW_CMD} poll idle_inhibit_status"
          (label :text {idle_inhibit_status.text}))
        (eventbox
          :class {"right-item status " + dnd_status.class}
          :tooltip {dnd_status.tooltip}
          :onclick "dunstctl set-paused toggle && ${EWW_CMD} poll dnd_status"
          (label :text {dnd_status.text})))
      (box :class "right-group" :space-evenly false
        (label :class "right-item language" :text {niri_state.language}))
      (box :class "right-group" :space-evenly false
        (eventbox
          :class {"right-item status " + volume_status.class}
          :tooltip {volume_status.tooltip}
          :onclick "pavucontrol"
          :onscroll "case {} in up) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%+;; down) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 1%-;; esac; ${EWW_CMD} poll volume_status"
          (label :text {volume_status.text}))
        (box
          :class {"right-item battery " + battery_status.class}
          :visible {battery_status.text != ""}
          :tooltip {battery_status.tooltip}
          (label :text {battery_status.text})))
      (box :class "right-group"
        (systray :class "right-item tray" :icon-size 14)))))

(defwindow topbar [screen]
  :monitor '["<primary>",0]'
  :geometry (geometry
    :x "0%"
    :y "0px"
    :width "100%"
    :height "42px"
    :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable "none"
  :namespace "eww-topbar"
  (topbar :screen screen))

(defwindow calendar_popup
  :monitor '["<primary>",0]'
  :geometry (geometry
    :x "0px"
    :y "46px"
    :width "280px"
    :height "175px"
    :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :focusable "ondemand"
  :namespace "eww-calendar"
  (box :class "calendar-popup"
    (calendar
      :class "calendar"
      :day {formattime(EWW_TIME, "%d")}
      :month {formattime(EWW_TIME, "%m")}
      :year {formattime(EWW_TIME, "%Y")}
      :show-details false
      :show-heading true
      :show-day-names true)))