{
  "markdown_preview": {
    "limit_content_width": false
  },
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": false,
  "cli_default_open_behavior": "new_window",
  "colorize_brackets": true,
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "redact_private_values": true,
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "buffer_font_family": "JetBrains Mono Nerd Font",
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "light",
    "light": "Fleet Light",
    "dark": "Ayu Dark"
  },
  "ui_font_family": "Atkinson Hyperlegible",
  "ui_font_size": 16.0,
  "base_keymap": "JetBrains",
  "vim_mode": false,
  "preferred_line_length": 120,
  "soft_wrap": "editor_width",
  "show_whitespaces": "all",
  "hard_tabs": false,
  "relative_line_numbers": "enabled",
  "show_edit_predictions": true,
  "formatter": "auto",
  "format_on_save": "off",
  "load_direnv": "shell_hook",
  "edit_predictions": {
    "provider": "copilot",
    "disabled_globs": [],
    "mode": "eager"
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "notification_panel": {
    "button": false
  },
  "project_panel": {
    "dock": "left",
    "git_status": true,
    "folder_icons": true,
    "file_icons": true
  },
  "outline_panel": {
    "dock": "right"
  },
  "terminal": {
    "font_size": 12.0,
    "dock": "bottom"
  },
  "git_panel": {
    "group_by": "status",
    "sort_by": "path",
    "dock": "left",
    "tree_view": true
  },
  "languages": {
    "Markdown": {
      "show_edit_predictions": true
    },
    "Typst": {
      "show_edit_predictions": true
    }
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow"
    },
    "default_profile": "ask",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex"
    },
    "model_parameters": []
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry",
      "favorite_config_option_values": {
        "model": [
          "opus"
        ]
      }
    }
  },
  "lsp": {
    "nil": {
      "settings": {
        "nil": {
          "nix": {
            "flake": {
              "autoArchive": true
            }
          }
        }
      }
    }
  },
  "context_servers": {
    "mcp-server-context7": {
      "enabled": false,
      "settings": {
        "default_minimum_tokens": "10000"
      }
    }
  }
}
